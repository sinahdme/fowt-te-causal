# ───────────────────────── OpenFAST / TurbSim outputs ─────────────────────────
# 200+ MB per .outb, hundreds of MB per .bts — way past GitHub's 100 MB limit.
# Regenerated by sims/run_campaign.py + TurbSim.
sims/**/*.outb
sims/**/*.bts
sims/**/*.sum
sims/**/*.dbg
sims/**/*.MD.out
sims/**/*.bak
sims/**/*.prev*
sims/**/openfast.log*
sims/**/turbsim.log*
sims/**/analysis_plots/

# DLC cases generated by run_campaign.py — regenerate on server, don't track.
# (Keep the drivers at sims/*.py and the hand-built sims/case-iea15-real/ inputs.)
sims/dlc16_*/
sims/dlca_*/
sims/dlcb_*/

# ───────────────────────── Phase 4/5 derived data ─────────────────────────────
# Regenerated by analysis/te_pipeline.py and sims/run_raft_lhs.py.
data/*.parquet
data/*.json
data/*.parquet.kept
# Top-level reports/*.parquet too: reports/**/*.parquet only matches subdirs,
# so reports/te_table.parquet was tracked and shipped a stale first-pass table
# to fresh clones, making phase4 look done. Untracked via git rm --cached.
reports/*.parquet
reports/*.json
reports/**/*.parquet
reports/**/*.json

# ───────────────────────── Generated report artifacts ─────────────────────────
# .docx outputs and unpack/extract artifacts — keep source (.js/.py) tracked.
reports/*.docx
reports/_unpacked_*/
reports/_v*_extracted.md
reports/_ver*_extracted.md
reports/~$*
reports/~WRL*.tmp

# ───────────────────────── Runtime logs ────────────────────────────────────────
# Pipeline stdout/stderr — regenerated each run. Narrative log is pages/log.md.
analysis/*.log
reports/**/*.log

# ───────────────────────── Vendored repos (2.5 GB) ────────────────────────────
# Cloned per SERVER_DEPLOYMENT.md §1 + §3a; not part of this project's source.
repos/

# ───────────────────────── Python bytecode ─────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ───────────────────────── Obsidian per-machine state ─────────────────────────
.obsidian/workspace*
.obsidian/cache/
.obsidian/cache.json

# ───────────────────────── Legacy / scratch ───────────────────────────────────
vault-legacy/
*.zip
Pictures/

# ───────────────────────── OS / editor ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ───────────────────────── Claude Code per-machine state ─────────────────────
.claude/

# ───────────────────────── Obsidian default-name artifacts ────────────────────
# Empty/blank files created by accidental "New canvas" / "New base" / daily-note.
Untitled.canvas
Untitled.base
Untitled[ -]*.canvas
Untitled[ -]*.base
# Daily-note files at vault root: YYYY-MM-DD.md. Add specific ones here
# rather than a wildcard, so intentional dated notes elsewhere still track.
/2026-05-13.md
